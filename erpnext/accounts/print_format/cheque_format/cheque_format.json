 "html": "\n<div style=\"position: relative; top:-0.15cm; font-size:15px;\">\n\t<div style=\"width:20.5cm;height:9.3cm;\">\n\t\t<span style=\"top:1.0cm; left:9.0cm;\n\t\t\tborder-bottom: solid 1px;border-top:solid 1px; position: absolute;\">\n\t\t\t\t<!-- Account Pay Only -->\n\t\t</span>\n\t\t<span style=\"top:0.0cm; left:14.2cm;\n\t\t\tposition: absolute; letter-spacing:0.5cm\">\n\t\t\t<!-- { doc.reference_date or '' } -->\n\t\t\t{%- if doc.doctype == 'Payment Entry' -%}\n                                {{frappe.utils.formatdate(doc.reference_date,'ddMMYYYY') if doc.reference_date else '' }}\n                        {%- else -%}\n                                {{frappe.utils.formatdate(doc.cheque_date,'ddMMYYYY') if doc.cheque_date else '' }}\n                        {%- endif -%}\n\t\t</span>\n\t\t<span style=\"top:5.0cm;left:4.0cm;\n\t\t\tposition: absolute;\">\n\t\t\t{{ doc.account_no or '' }}\n\t\t</span>\n\t\t<span style=\"top:1.9cm;left: 1.8cm;\n\t\t\tposition: absolute;\">\n\t\t\t<!-- { doc.party } -->\n\t\t\t{{ doc.pay_to_recd_from }}\n\t\t</span>\n\t\t<span style=\"top:2.8cm; left:2.6cm;\n\t\t\tposition: absolute; display: block; width: 9.5cm;\n\t\t\tline-height:1.19cm; word-wrap: break-word;\">\n\t\t\t\t<!-- {frappe.utils.money_in_words(doc.base_paid_amount or doc.base_received_amount)} -->\n\t\t\t\t{%- if doc.doctype == 'Payment Entry' -%}\n                                        {{frappe.utils.money_in_words(doc.base_paid_amount or doc.base_received_amount)[3:]}}\n\t\t\t\t{%- else -%}\n                                        {% set total_amount = [0] %}\n                                        {%- for row in doc.accounts -%}\n                                                {%- if frappe.db.get_value(\"Account\", row.account, \"account_type\") == 'Bank' -%}\n                                                        {%- if total_amount.append(total_amount.pop() + row.credit_in_account_currency) -%}{%- endif -%}\n                                                {%- endif -%}\n                                        {%- endfor -%}\n                                        {{frappe.utils.money_in_words(total_amount[0])[3:]}}\n\t\t\t\t{%- endif -%}\n\t\t</span>\n\t\t<span style=\"top:3.5cm;left: 16.0cm;\n\t\t\tposition: absolute;\">\n\t\t\t<!-- {doc.get_formatted(\"base_paid_amount\") or doc.get_formatted(\"base_received_amount\")} -->\n\t\t\t{%- if doc.doctype == 'Payment Entry' -%}\n                                <!-- {{doc.get_formatted(\"base_paid_amount\") or doc.get_formatted(\"base_received_amount\")}} -->\n                                {{ '{0:,.2f}'.format(doc.base_paid_amount) if doc.base_paid_amount else '{0:,.2f}'.format(doc.base_received_amount) }}\n                        {%- else -%}\n                                {{ '{0:,.2f}'.format(total_amount[0]) }}\n                        {%- endif -%}\n\t\t</span>\n\t\t<span style=\"top:6.0cm;left: 15.0cm;\n\t\t\tposition: absolute;\">\n\t\t\t<!-- {{doc.company}} -->\n\t\t</span>\n\t</div>\n</div>",
